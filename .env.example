CORE_HOST=127.0.0.1
CORE_PORT=3040
CORE_DB_PATH=./data/conversations.db
WHATSAPP_PHONE=+54 264 628-1854
DEBUG=false

# Integración WhatsApp: link (default) | api
# link = genera wa.me y el consumidor cierra por WhatsApp (sin tokens Meta)
# api  = WhatsApp Cloud API con envío automático (requiere credenciales Meta)
WHATSAPP_MODE=link

# Solo necesario si WHATSAPP_MODE=api (Meta Business Manager > WhatsApp > API Setup)
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WEBHOOK_VERIFY_TOKEN=your_custom_verify_string
WHATSAPP_APP_SECRET=your_meta_app_secret
